    "# единый парсер: строка = структурное подразделение МО\n",
    "def load_registry(path):\n",
    "    raw = pd.read_excel(path, header=None, dtype=str)\n",
    "    # строка данных: первый столбец — целое число (№пп)\n",
    "    is_data = raw[0].astype(str).str.fullmatch(r'\\d+')\n",
