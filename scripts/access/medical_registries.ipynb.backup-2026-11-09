    "import re\n",
    "\n",
    "MO_STEMS = ['Кош-Агачский', 'Майминский', 'Онгудайский', 'Турочакский', 'Улаганский',\n",
    "            'Усть-Канский', 'Усть-Коксинский', 'Чемальский', 'Чойский', 'Шебалинский']\n",
    "\n",
    "def parse_district(addr):\n",
    "    if not isinstance(addr, str):\n",
    "        return None\n",
    "    seg = re.split(r'(?:Респ(?:ублика)? ?Алтай),', addr, maxsplit=1)\n",
    "    if len(seg) < 2:\n",
    "        return None\n",
    "    d = seg[1].strip()\n",
    "    if 'Горно-Алтайск' in d:\n",
    "        return 'г. Горно-Алтайск'\n",
    "    for stem in MO_STEMS:\n",
    "        if stem in d:\n",
    "            return stem + ' район'\n",
    "    return d.split(',')[0].strip() or None\n",
    "\n",
    "def unit_type(row):\n",
    "    txt = ' '.join(str(row[c]) for c in ['МО', 'наименование_подразделения'] if isinstance(row[c], str)).lower()\n",
    "    if 'фельдшерско-акушерский' in txt or re.search(r'фап\\b|фапа\\b', txt):\n",
    "        return 'ФАП'\n",
    "    if 'фельдшерский' in txt:\n",
    "        return 'ФАП'\n",
    "    if 'амбулатор' in txt:\n",
    "        return 'амбулатория'\n",
    "    if 'больниц' in txt or 'госпитал' in txt or 'центр' in txt:\n",
    "        return 'больница/центр'\n",
    "    if 'поликлиник' in txt or 'стоматолог' in txt:\n",
    "        return 'поликлиника/стоматология'\n",
    "    return 'прочее'\n",
    "\n",
    "units['район'] = units['адрес_подразделения'].apply(parse_district)\n",
    "units['тип'] = units.apply(unit_type, axis=1)\n",
    "print(units['тип'].value_counts())\n",
    "print('\\nпо районам:'); print(units['район'].value_counts(dropna=False))"
