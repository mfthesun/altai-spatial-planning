    "# Влияние на ОНП: у каждого из 37 кандидатов ищем действующую точку в его НП\n",
    "import re\n",
    "onp = pd.read_csv(REPO / 'data/onp_candidates.csv', encoding='utf-8-sig')\n",
    "\n",
    "def norm(s):\n",
    "    return str(s).lower().replace('ё', 'е')\n",
    "\n",
    "act = locs[locs['действует']].copy()\n",
    "act['адрес_n'] = act['адрес_подразделения'].map(norm)\n",
    "\n",
    "def find_point(settlement):\n",
    "    # «село Кош-Агач» -> «кош-агач»\n",
    "    nm = re.sub(r'^(село|с |с\\.\\s*|поселок|п\\.\\s*|г\\.?\\s*)\\s*', '', norm(settlement), flags=re.I).strip()\n",
    "    if nm == 'горно-алтайск':\n",
    "        nm = 'горно-алтайск'\n",
    "    sub = act[act['адрес_n'].str.contains(nm, regex=False)]\n",
    "    if len(sub) == 0:\n",
    "        return None\n",
    "    # приоритет: больница > амбулатория > ФАП > прочее\n",
    "    for t in ['больница/центр', 'амбулатория', 'ФАП', 'поликлиника/стоматология', 'прочее']:\n",
    "        s2 = sub[sub['тип'] == t]\n",
    "        if len(s2):\n",
    "            return t\n",
    "    return sub['тип'].iloc[0]\n",
    "\n",
    "onp['точка_по_реестру'] = onp['name'].apply(find_point)\n",
    "print('ОНП с точкой по реестру:', onp['точка_по_реестру'].notna().sum(), 'из', len(onp))\n",
    "print(onp['точка_по_реестру'].value_counts(dropna=False))\n",
    "print('\\nбез точки в НП по адресу:'); print(onp.loc[onp['точка_по_реестру'].isna(), ['name', 'mo', 'основание']].to_string(max_colwidth=60))"
